---
const navItems = [
  { label: 'Overview', href: '#hero' },
  { label: 'Hardware', href: '#infrastructure' },
  { label: 'Network', href: '#networking' },
  { label: 'Development', href: '#development' },
  { label: 'Monitoring', href: '#monitoring' },
  { label: 'Contact', href: '#contact' },
];
---

<header id="site-header" role="banner">
  <div class="header-frame">
    <a href="#hero" class="header-logo" aria-label="Sharif Madber — system overview">
      <img src="/assets/brand/sm-shield.svg" alt="" aria-hidden="true" width="31" height="38" />
      <span class="wordmark"><strong>SHARIF</strong><span>MADBER</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul role="list">
        {navItems.map(({ label, href }, index) => (
          <li>
            <a href={href} data-navlink>
              <small>{String(index).padStart(2, '0')}</small>{label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <span class="system-label" aria-hidden="true">PORTFOLIO / 2026</span>
      <button id="quality-toggle" class="quality-toggle" type="button" aria-label="Disable 3D experience" aria-pressed="false">
        <span class="quality-dot"></span><span class="quality-label">3D ON</span>
      </button>
      <button id="mobile-menu-btn" class="mobile-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ol>
        {navItems.map(({ label, href }, index) => (
          <li><a href={href} data-mobile-navlink><span>{String(index).padStart(2, '0')}</span>{label}</a></li>
        ))}
      </ol>
    </nav>
    <p>Enterprise networks · Hardware operations · Full-stack systems</p>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const qualityButton = document.getElementById('quality-toggle');
  const qualityLabel = qualityButton?.querySelector('.quality-label');
  const mobileLinks = document.querySelectorAll('[data-mobile-navlink]');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('[data-navlink]');

  function updateHeader() {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  }

  function closeMenu() {
    mobileMenu?.setAttribute('aria-hidden', 'true');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open navigation menu');
    document.body.classList.remove('menu-is-open');
  }

  function openMenu() {
    mobileMenu?.setAttribute('aria-hidden', 'false');
    menuButton?.setAttribute('aria-expanded', 'true');
    menuButton?.setAttribute('aria-label', 'Close navigation menu');
    document.body.classList.add('menu-is-open');
    mobileMenu?.querySelector<HTMLAnchorElement>('a')?.focus();
  }

  menuButton?.addEventListener('click', () => {
    menuButton.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
  });
  mobileLinks.forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const liteStorageKey = 'sm-lite-mode';
  function isLiteMode() { return localStorage.getItem(liteStorageKey) === 'true'; }
  function renderQualityState(lite: boolean) {
    qualityButton?.classList.toggle('is-lite', lite);
    qualityButton?.setAttribute('aria-pressed', String(lite));
    qualityButton?.setAttribute('aria-label', lite ? 'Enable 3D experience' : 'Disable 3D experience');
    if (qualityLabel) qualityLabel.textContent = lite ? '3D OFF' : '3D ON';
  }
  renderQualityState(isLiteMode());
  qualityButton?.addEventListener('click', () => {
    const lite = !isLiteMode();
    localStorage.setItem(liteStorageKey, String(lite));
    renderQualityState(lite);
    window.dispatchEvent(new CustomEvent('litemode', { detail: { lite } }));
  });

  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      desktopLinks.forEach((link) => {
        const active = link.getAttribute('href') === `#${entry.target.id}`;
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    });
  }, { rootMargin: '-43% 0px -43% 0px' });
  sections.forEach((section) => sectionObserver.observe(section));

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
</script>

<style>
  #site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 0.85rem 1rem 0;
    pointer-events: none;
  }

  .header-frame {
    width: min(100%, 94rem);
    min-height: 4.15rem;
    margin-inline: auto;
    padding: 0.55rem 0.7rem 0.55rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid transparent;
    pointer-events: auto;
    transition: background 220ms ease, border-color 220ms ease, backdrop-filter 220ms ease;
  }

  #site-header.is-scrolled .header-frame {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(7, 9, 7, 0.78);
    backdrop-filter: blur(22px) saturate(130%);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 0 0 auto;
    color: var(--color-text);
    text-decoration: none;
  }

  .header-logo img {
    width: 1.75rem;
    height: auto;
    filter: drop-shadow(0 0 8px rgba(57, 255, 20, 0.28));
  }

  .wordmark {
    display: grid;
    line-height: 1;
    font-family: var(--font-display);
    font-size: 0.73rem;
    letter-spacing: 0.12em;
  }

  .wordmark strong { color: var(--color-text); font-weight: 650; }
  .wordmark span { margin-top: 0.22rem; color: var(--color-green); font-size: 0.6rem; letter-spacing: 0.2em; }

  .desktop-nav { flex: 1; }
  .desktop-nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.15rem, 0.8vw, 0.7rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.55rem 0.6rem;
    color: #828b84;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease, background 160ms ease;
  }

  .desktop-nav small { color: #4e574f; font-size: 0.52rem; }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] { color: var(--color-green); background: rgba(57, 255, 20, 0.045); }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 0 0 auto;
  }

  .system-label {
    color: #555e56;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    letter-spacing: 0.1em;
  }

  .quality-toggle {
    min-height: 2.35rem;
    display: flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(57, 255, 20, 0.25);
    border-radius: 0;
    background: rgba(57, 255, 20, 0.04);
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .quality-dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .quality-toggle.is-lite { color: #737b74; border-color: rgba(255, 255, 255, 0.12); }

  .mobile-menu-btn {
    width: 2.4rem;
    height: 2.4rem;
    display: none;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    background: rgba(6, 8, 6, 0.8);
    cursor: pointer;
  }

  .mobile-menu-btn span {
    position: absolute;
    width: 1rem;
    height: 1px;
    background: var(--color-text);
    transition: transform 180ms ease;
  }
  .mobile-menu-btn span:first-child { transform: translateY(-3px); }
  .mobile-menu-btn span:last-child { transform: translateY(3px); }
  .mobile-menu-btn[aria-expanded='true'] span:first-child { transform: rotate(45deg); }
  .mobile-menu-btn[aria-expanded='true'] span:last-child { transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: grid;
    align-content: center;
    padding: 6rem 1.25rem 2rem;
    background: rgba(5, 7, 5, 0.97);
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  .mobile-menu[aria-hidden='false'] { opacity: 1; visibility: visible; }
  .mobile-menu ol { width: min(100%, 32rem); margin: 0 auto; padding: 0; list-style: none; }
  .mobile-menu li { border-bottom: 1px solid rgba(255, 255, 255, 0.09); }
  .mobile-menu a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 9vw, 3.2rem);
    letter-spacing: -0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .mobile-menu a span { color: var(--color-green); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; }
  .mobile-menu p { width: min(100%, 32rem); margin: 2rem auto 0; font-family: var(--font-mono); font-size: 0.65rem; }

  @media (max-width: 1100px) {
    .desktop-nav a { padding-inline: 0.4rem; }
    .system-label { display: none; }
  }

  @media (max-width: 860px) {
    #site-header { padding: 0.65rem; }
    .header-frame { padding-left: 0.65rem; background: rgba(7, 9, 7, 0.76); backdrop-filter: blur(18px); border-color: rgba(255, 255, 255, 0.09); }
    .desktop-nav { display: none; }
    .header-actions { margin-left: auto; }
    .mobile-menu-btn { display: grid; }
  }

  @media (max-width: 430px) {
    .wordmark { display: none; }
  }
</style>
