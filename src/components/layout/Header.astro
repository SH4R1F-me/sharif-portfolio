---
// Header.astro — Sticky glassmorphism navigation

import { profile } from '../../data/profile';

const navItems = [
  { label: 'Home',      href: '#hero' },
  { label: 'About',     href: '#about' },
  { label: 'Expertise', href: '#expertise' },
  { label: 'Projects',  href: '#projects' },
  { label: 'Contact',   href: '#contact' },
];
---

<header id="site-header" role="banner">
  <div class="header-inner container">
    <!-- Logo -->
    <a href="#hero" class="header-logo" aria-label="Sharif Madber — home">
      <img src="/assets/brand/sm-shield.svg" alt="" aria-hidden="true" width="36" height="44" />
      <span class="header-name">
        <span class="header-name-first">Sharif</span>
        <span class="header-name-last">Madber</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" role="navigation" aria-label="Main navigation">
      <ul role="list">
        {navItems.map(({ label, href }) => (
          <li>
            <a href={href} class="nav-link" data-navlink>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Actions -->
    <div class="header-actions">
      <!-- Lite/3D Toggle -->
      <button
        id="quality-toggle"
        class="toggle-btn"
        aria-label="Switch to Lite Mode — disable 3D animation"
        title="Toggle Lite Mode"
      >
        <span class="toggle-icon" aria-hidden="true">⚡</span>
        <span class="toggle-label">Lite</span>
      </button>

      {profile.cvPath && (
        <a href={profile.cvPath} class="btn btn-primary btn-sm" download aria-label="Download CV PDF">
          Download CV
        </a>
      )}
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      <span class="hamburger" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" role="dialog" aria-label="Navigation menu" aria-modal="true">
    <nav aria-label="Mobile navigation">
      <ul role="list">
        {navItems.map(({ label, href }) => (
          <li>
            <a href={href} class="mobile-nav-link" data-mobile-navlink>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {profile.cvPath && (
      <a href={profile.cvPath} class="btn btn-secondary" download style="margin-top:1.5rem;width:100%;justify-content:center;">
        Download CV
      </a>
    )}
  </div>
</header>

<style>
  /* ── Header shell ── */
  #site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  #site-header.scrolled {
    background: rgba(11, 17, 26, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom-color: var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 72px;
  }

  /* ── Logo ── */
  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-logo img {
    height: 40px;
    width: auto;
  }

  .header-name {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .header-name-first {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .header-name-last {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  /* ── Desktop nav ── */
  .header-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header-nav ul {
    display: flex;
    list-style: none;
    gap: var(--space-1);
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast), background var(--duration-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: var(--color-cyan);
    border-radius: 1px;
    transition: width var(--duration-normal) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .nav-link[aria-current="page"]::after,
  .nav-link:hover::after {
    width: calc(100% - 1.75rem);
  }

  /* ── Actions ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.375rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--duration-fast), color var(--duration-fast);
    font-family: var(--font-body);
  }

  .toggle-btn:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
  }

  .toggle-btn.lite-active {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
    background: var(--color-cyan-dim);
  }

  .btn-sm {
    padding: 0.5rem 1.125rem;
    font-size: var(--text-xs);
  }

  /* ── Mobile menu button ── */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    margin-left: auto;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 24px;
  }

  .hamburger span {
    display: block;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform var(--duration-normal) var(--ease-out),
                opacity var(--duration-fast);
  }

  /* Hamburger → X animation */
  #site-header.menu-open .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #site-header.menu-open .hamburger span:nth-child(2) {
    opacity: 0;
  }
  #site-header.menu-open .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 72px 0 0 0;
    background: rgba(11, 17, 26, 0.97);
    backdrop-filter: blur(20px);
    padding: var(--space-8) var(--space-6);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--duration-normal) var(--ease-out);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu[aria-hidden="false"] {
    transform: translateX(0);
  }

  .mobile-menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link {
    display: block;
    padding: var(--space-4);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--duration-fast), background var(--duration-fast);
  }

  .mobile-nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .header-nav,
    .header-actions { display: none; }
    .mobile-menu-btn { display: flex; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const mobileBtn = document.getElementById('mobile-menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const qualityToggle = document.getElementById('quality-toggle')!;
  const mobileLinks = document.querySelectorAll('[data-mobile-navlink]');

  // ── Scroll effect ──
  const onScroll = () => {
    header.classList.toggle('scrolled', window.scrollY > 20);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Mobile menu ──
  function openMenu() {
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileBtn.setAttribute('aria-expanded', 'true');
    mobileBtn.setAttribute('aria-label', 'Close navigation menu');
    header.classList.add('menu-open');
    document.body.style.overflow = 'hidden';
    // Focus first link
    const firstLink = mobileMenu.querySelector('a') as HTMLElement | null;
    firstLink?.focus();
  }

  function closeMenu() {
    mobileMenu.setAttribute('aria-hidden', 'true');
    mobileBtn.setAttribute('aria-expanded', 'false');
    mobileBtn.setAttribute('aria-label', 'Open navigation menu');
    header.classList.remove('menu-open');
    document.body.style.overflow = '';
    mobileBtn.focus();
  }

  mobileBtn.addEventListener('click', () => {
    const isOpen = mobileBtn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileBtn.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // Close when mobile nav link clicked
  mobileLinks.forEach((link) => link.addEventListener('click', closeMenu));

  // ── Lite Mode toggle ──
  const LITE_KEY = 'sm-lite-mode';
  const isLite = () => localStorage.getItem(LITE_KEY) === 'true';

  function applyLiteMode(lite: boolean) {
    document.documentElement.classList.toggle('lite-mode', lite);
    qualityToggle.classList.toggle('lite-active', lite);
    qualityToggle.setAttribute(
      'aria-label',
      lite ? 'Switch to Full Mode — enable 3D animation' : 'Switch to Lite Mode — disable 3D animation'
    );
    qualityToggle.querySelector('.toggle-label')!.textContent = lite ? 'Full' : 'Lite';
    qualityToggle.querySelector('.toggle-icon')!.textContent = lite ? '🌐' : '⚡';
  }

  // Init from storage
  applyLiteMode(isLite());

  qualityToggle.addEventListener('click', () => {
    const newVal = !isLite();
    localStorage.setItem(LITE_KEY, String(newVal));
    applyLiteMode(newVal);
    // Dispatch event for the 3D scene to react
    window.dispatchEvent(new CustomEvent('litemode', { detail: { lite: newVal } }));
  });

  // ── Active nav link on scroll ──
  const navLinks = document.querySelectorAll('[data-navlink]');
  const sections = document.querySelectorAll('section[id]');

  const navObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            link.setAttribute(
              'aria-current',
              href === `#${entry.target.id}` ? 'page' : 'false'
            );
          });
        }
      });
    },
    { rootMargin: '-40% 0px -40% 0px' }
  );

  sections.forEach((section) => navObserver.observe(section));
</script>
