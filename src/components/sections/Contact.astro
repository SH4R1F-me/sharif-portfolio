---

<section
  id="contact"
  class="section contact-section"
  aria-labelledby="contact-heading"
>
  <div class="container">
    <div class="contact-grid">
      <!-- Copy -->
      <div class="contact-copy">
        <p class="section-label reveal">Contact</p>
        <h2 id="contact-heading" class="reveal" style="animation-delay:0.1s">
          Let's Connect
        </h2>
        <p class="contact-desc reveal" style="animation-delay:0.2s">
          Whether you're a recruiter, potential client, or fellow professional —
          LinkedIn is the best place to start a conversation.
        </p>

        <p class="contact-note reveal" style="animation-delay:0.3s">
          <span class="dot-available" role="img" aria-label="Status indicator"
          ></span>
          Open to professional opportunities and technical discussions.
        </p>
      </div>

      <!-- Links -->
      <div class="contact-links reveal" style="animation-delay:0.2s">
        {
          socialLinks.map(({ platform, label, url }) => (
            <a
              href={url}
              class="contact-link"
              target={url.startsWith("mailto") ? undefined : "_blank"}
              rel={url.startsWith("mailto") ? undefined : "noopener noreferrer"}
              aria-label={`${label}${url.startsWith("mailto") ? "" : " — opens in new tab"}`}
            >
              <div
                class="contact-link-icon"
                set:html={iconMap[platform] ?? iconMap.email}
              />
              <div class="contact-link-text">
                <span class="contact-link-label">{label}</span>
                <span class="contact-link-url">
                  {url
                    .replace("mailto:", "")
                    .replace("https://", "")
                    .replace("http://", "")}
                </span>
              </div>
              <span class="contact-link-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }

        {
          profile.cvPath && (
            <a
              href={profile.cvPath}
              class="contact-link contact-link-cv"
              download
              aria-label="Download CV PDF"
            >
              <div class="contact-link-icon" aria-hidden="true">
                ↓
              </div>
              <div class="contact-link-text">
                <span class="contact-link-label">Download CV</span>
                <span class="contact-link-url">PDF resume</span>
              </div>
              <span class="contact-link-arrow" aria-hidden="true">
                ↓
              </span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
  }

  .contact-section::before {
    content: "";
    position: absolute;
    right: -100px;
    bottom: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(0, 229, 255, 0.06) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-20);
    align-items: start;
  }

  .contact-copy h2 {
    margin-bottom: var(--space-6);
  }

  .contact-desc {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-muted);
    margin-bottom: var(--space-8);
    max-width: 40ch;
  }

  .contact-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-green);
    max-width: none;
  }

  /* Contact links */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    group: true;
  }

  .contact-link:hover {
    border-color: var(--color-cyan);
    background: var(--color-surface-hover);
    transform: translateX(4px);
    text-decoration-color: transparent;
  }

  .contact-link-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-md);
    color: var(--color-cyan);
    flex-shrink: 0;
    font-size: var(--text-lg);
    border: 1px solid var(--color-border);
    transition:
      border-color var(--duration-fast),
      background var(--duration-fast);
  }

  .contact-link:hover .contact-link-icon {
    border-color: var(--color-cyan);
    background: var(--color-cyan-dim);
  }

  .contact-link-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-link-label {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
  }

  .contact-link-url {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-link-arrow {
    color: var(--color-muted);
    font-size: var(--text-lg);
    transition:
      color var(--duration-fast),
      transform var(--duration-fast);
    flex-shrink: 0;
  }

  .contact-link:hover .contact-link-arrow {
    color: var(--color-cyan);
    transform: translateX(4px);
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
