---
// Hero.astro — First screen: name, title, CTAs, 3D scene

import { profile } from "../../data/profile";
import { socialLinks } from "../../data/socials";

const linkedinLink = socialLinks.find((l) => l.platform === "linkedin");
---

<section id="hero" class="hero" aria-label="Introduction">
  <div class="container hero-container">
    <!-- Text content — always visible, no JS required -->
    <div class="hero-copy">
      <p class="section-label reveal" aria-hidden="true">Portfolio</p>

      <h1 class="hero-name reveal" style="animation-delay:0.1s">
        <span class="hero-name-first">Sharif</span>
        <br />
        <span class="hero-name-last gradient-text">Madber</span>
      </h1>

      <p class="hero-title reveal" style="animation-delay:0.2s">
        {profile.professionalTitle}
      </p>

      <p class="hero-summary reveal" style="animation-delay:0.3s">
        {profile.shortSummary}
      </p>

      <!-- CTAs -->
      <div class="hero-cta reveal" style="animation-delay:0.4s">
        <a href="#projects" class="btn btn-primary">
          <span aria-hidden="true">→</span>
          Explore My Work
        </a>

        {
          linkedinLink && (
            <a
              href={linkedinLink.url}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn Profile — opens in new tab"
            >
              <span aria-hidden="true">🔗</span>
              LinkedIn Profile
            </a>
          )
        }

        {
          profile.cvPath && (
            <a
              href={profile.cvPath}
              class="btn btn-secondary"
              download
              aria-label="Download CV PDF"
            >
              <span aria-hidden="true">↓</span>
              Download CV
            </a>
          )
        }
      </div>
    </div>

    <!-- 3D Scene / Poster -->
    <div class="hero-visual" aria-hidden="true">
      <!-- Static poster (always shown, replaced by R3F when JS loads) -->
      <div class="hero-poster" id="hero-poster">
        <img
          src="/assets/brand/sm-shield.svg"
          alt=""
          class="hero-shield-poster"
          width="300"
          height="370"
        />
        <div class="hero-orbit-ring ring-1" aria-hidden="true"></div>
        <div class="hero-orbit-ring ring-2" aria-hidden="true"></div>
        <div class="hero-nodes" aria-hidden="true">
          {
            [...Array(6)].map((_, i) => (
              <div class={`hero-node node-${i + 1}`} />
            ))
          }
        </div>
        <div class="hero-glow" aria-hidden="true"></div>
      </div>

      <!-- React Three Fiber scene — lazy loaded, Lite Mode aware -->
      <div id="hero-3d-container" class="hero-3d-container" aria-hidden="true">
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="hero-scroll-hint" aria-hidden="true">
    <div class="scroll-arrow"></div>
    <span>Scroll to explore</span>
  </div>

  <!-- Ambient particles (CSS only) -->
  <div class="hero-particles" aria-hidden="true">
    {[...Array(12)].map((_, i) => <div class={`particle p-${i + 1}`} />)}
  </div>
</section>

<!-- 3D Scene island — client only, isolated -->
<script type="module" is:inline>
  // Only initialize 3D if not in Lite Mode and WebGL is available
  function isLiteMode() {
    return (
      localStorage.getItem("sm-lite-mode") === "true" ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  }

  function hasWebGL() {
    try {
      const canvas = document.createElement("canvas");
      return !!(
        canvas.getContext("webgl") || canvas.getContext("experimental-webgl")
      );
    } catch {
      return false;
    }
  }

  async function initScene() {
    if (isLiteMode() || !hasWebGL()) return;

    const container = document.getElementById("hero-3d-container");
    if (!container) return;

    // Lazy import Three.js scene
    const { initHeroScene } = await import("../three/HeroScene.ts");
    initHeroScene(container);
  }

  // Init after page load
  if (document.readyState === "complete") {
    initScene();
  } else {
    window.addEventListener("load", initScene, { once: true });
  }

  // React to Lite Mode toggle
  window.addEventListener("litemode", (e) => {
    const { lite } = e.detail;
    const container = document.getElementById("hero-3d-container");
    const poster = document.getElementById("hero-poster");
    if (lite) {
      if (container) container.innerHTML = "";
      if (poster) poster.style.opacity = "1";
    } else {
      initScene();
    }
  });
</script>

<style>
  /* ── Hero section ── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding-top: 72px; /* header height */
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
    min-height: calc(100svh - 72px);
    padding-block: var(--space-16);
  }

  /* ── Copy ── */
  .hero-copy {
    z-index: 2;
  }

  .hero-name {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .hero-name-first {
    color: var(--color-text);
  }

  .hero-name-last {
    display: inline-block;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--color-cyan);
    margin-bottom: var(--space-6);
    max-width: none;
    text-transform: uppercase;
  }

  .hero-summary {
    font-size: clamp(var(--text-base), 2vw, var(--text-xl));
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 50ch;
    margin-bottom: var(--space-10);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ── Visual ── */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 480px;
  }

  .hero-poster {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transition: opacity var(--duration-slow);
  }

  .hero-shield-poster {
    width: clamp(160px, 25vw, 280px);
    height: auto;
    filter: drop-shadow(0 0 30px rgba(0, 229, 255, 0.4));
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shield-poster {
      animation: none;
    }
  }

  /* Orbit rings (CSS) */
  .hero-orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(0, 229, 255, 0.15);
    pointer-events: none;
  }

  .ring-1 {
    width: 320px;
    height: 320px;
    animation: orbit1 20s linear infinite;
  }

  .ring-2 {
    width: 450px;
    height: 450px;
    border-color: rgba(215, 168, 75, 0.08);
    animation: orbit2 30s linear infinite reverse;
  }

  @keyframes orbit1 {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orbit2 {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-1,
    .ring-2 {
      animation: none;
    }
  }

  /* Network nodes */
  .hero-nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-node {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--color-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-cyan);
    animation: nodePulse 3s ease-in-out infinite;
  }

  .node-1 {
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }
  .node-2 {
    top: 10%;
    right: 15%;
    animation-delay: 0.5s;
  }
  .node-3 {
    top: 65%;
    left: 5%;
    animation-delay: 1s;
  }
  .node-4 {
    bottom: 15%;
    right: 10%;
    animation-delay: 1.5s;
  }
  .node-5 {
    top: 40%;
    right: 5%;
    animation-delay: 0.75s;
  }
  .node-6 {
    bottom: 30%;
    left: 20%;
    animation-delay: 1.25s;
  }

  @keyframes nodePulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-node {
      animation: none;
      opacity: 0.5;
    }
  }

  /* Glow backdrop */
  .hero-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(0, 229, 255, 0.1) 0%,
      transparent 70%
    );
    border-radius: 50%;
    pointer-events: none;
  }

  /* 3D container (hidden until scene loads) */
  .hero-3d-container {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  /* Scroll hint */
  .hero-scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: scrollHint 2s ease-in-out infinite;
  }

  .scroll-arrow {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-cyan), transparent);
    border-radius: 1px;
  }

  @keyframes scrollHint {
    0%,
    100% {
      opacity: 0.4;
      transform: translateX(-50%) translateY(0);
    }
    50% {
      opacity: 0.8;
      transform: translateX(-50%) translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-hint {
      animation: none;
      opacity: 0.5;
    }
  }

  /* Particles */
  .hero-particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .particle {
    position: absolute;
    width: 2px;
    height: 2px;
    background: var(--color-cyan);
    border-radius: 50%;
    opacity: 0;
    animation: particleDrift var(--dur, 8s) var(--delay, 0s) ease-in-out
      infinite;
  }

  .p-1 {
    left: 5%;
    top: 20%;
    --dur: 9s;
    --delay: 0s;
  }
  .p-2 {
    left: 15%;
    top: 70%;
    --dur: 12s;
    --delay: 1s;
  }
  .p-3 {
    left: 25%;
    top: 40%;
    --dur: 8s;
    --delay: 2s;
  }
  .p-4 {
    left: 40%;
    top: 85%;
    --dur: 11s;
    --delay: 0.5s;
  }
  .p-5 {
    left: 55%;
    top: 15%;
    --dur: 7s;
    --delay: 1.5s;
  }
  .p-6 {
    left: 65%;
    top: 55%;
    --dur: 10s;
    --delay: 3s;
  }
  .p-7 {
    left: 75%;
    top: 30%;
    --dur: 9s;
    --delay: 2.5s;
  }
  .p-8 {
    left: 85%;
    top: 75%;
    --dur: 13s;
    --delay: 1s;
  }
  .p-9 {
    left: 90%;
    top: 50%;
    --dur: 8s;
    --delay: 4s;
  }
  .p-10 {
    left: 30%;
    top: 10%;
    --dur: 10s;
    --delay: 0.3s;
  }
  .p-11 {
    left: 50%;
    top: 60%;
    --dur: 11s;
    --delay: 2s;
  }
  .p-12 {
    left: 70%;
    top: 90%;
    --dur: 9s;
    --delay: 1.7s;
  }

  @keyframes particleDrift {
    0% {
      opacity: 0;
      transform: translateY(0) scale(1);
    }
    20% {
      opacity: 0.4;
    }
    80% {
      opacity: 0.2;
    }
    100% {
      opacity: 0;
      transform: translateY(-80px) scale(0.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle {
      display: none;
    }
  }

  /* ── Background grid ── */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(38, 53, 72, 0.2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(38, 53, 72, 0.2) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
    z-index: 0;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 60% at 70% 50%,
      rgba(0, 229, 255, 0.04) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }
  .hero-scroll-hint {
    z-index: 1;
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-block: var(--space-10);
    }

    .hero-visual {
      height: 280px;
      order: -1;
    }

    .hero-name {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-cta .btn {
      justify-content: center;
    }

    .hero-scroll-hint {
      display: none;
    }
  }
</style>
