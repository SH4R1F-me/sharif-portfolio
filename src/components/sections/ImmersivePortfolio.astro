---
import { profile } from '../../data/profile';
import { socialLinks } from '../../data/socials';

const linkedIn = socialLinks.find((link) => link.platform === 'linkedin');

const scenes = [
  { id: 'hero', label: 'Overview', code: '00' },
  { id: 'infrastructure', label: 'Hardware', code: '01' },
  { id: 'networking', label: 'Network', code: '02' },
  { id: 'development', label: 'Development', code: '03' },
  { id: 'monitoring', label: 'Monitoring', code: '04' },
  { id: 'contact', label: 'Contact', code: '05' },
];
---

<div class="experience" id="experience-root">
  <div class="scene-layer" aria-hidden="true">
    <div id="infrastructure-canvas" class="scene-canvas"></div>
    <div id="scene-fallback" class="scene-fallback">
      <div class="fallback-rack">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="fallback-orbit"></div>
    </div>
    <div class="scene-vignette"></div>
  </div>

  <aside class="scene-rail" aria-label="Experience sections">
    <div class="rail-track" aria-hidden="true"><span id="rail-progress"></span></div>
    <ol>
      {scenes.map((scene, index) => (
        <li>
          <a href={`#${scene.id}`} data-scene-link={index} aria-label={`Go to ${scene.label}`}>
            <span class="rail-code">{scene.code}</span>
            <span class="rail-label">{scene.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </aside>

  <div class="system-hud" aria-hidden="true">
    <span class="hud-pulse"></span>
    <span id="hud-scene">SYSTEM OVERVIEW</span>
    <span class="hud-separator">/</span>
    <span>LIVE</span>
  </div>

  <section id="hero" class="scene-section hero-scene" data-scene-index="0" aria-labelledby="hero-heading">
    <div class="scene-container scene-left">
      <div class="scene-copy hero-copy reveal">
        <p class="scene-kicker"><span>SYS.00</span> Infrastructure engineer & developer</p>
        <h1 id="hero-heading">
          Engineering systems<br />
          <span class="neon-type" data-text="THAT STAY ONLINE.">that stay online.</span>
        </h1>
        <p class="hero-lede">
          {profile.shortSummary}
        </p>

        <div class="hero-actions">
          <a class="action action-primary" href="#infrastructure">
            Explore the system <span aria-hidden="true">↘</span>
          </a>
          {linkedIn && (
            <a class="action action-ghost" href={linkedIn.url} target="_blank" rel="noopener noreferrer">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>

        <div class="hero-capabilities" aria-label="Core capabilities">
          <div><span>01</span><strong>Enterprise networking</strong><small>VLAN · VPN · 10G</small></div>
          <div><span>02</span><strong>Hardware operations</strong><small>RAID · Linux · Storage</small></div>
          <div><span>03</span><strong>Full-stack systems</strong><small>Next.js · NestJS · AI</small></div>
        </div>
      </div>

      <div class="scroll-cue" aria-hidden="true">
        <span>Scroll to enter</span>
        <i></i>
      </div>
    </div>
  </section>

  <section id="infrastructure" class="scene-section" data-scene-index="1" aria-labelledby="infrastructure-heading">
    <div class="scene-container scene-left">
      <article class="scene-copy glass-panel reveal">
        <div class="panel-index"><span>01</span><span>HARDWARE PLANE</span></div>
        <p class="scene-kicker"><span>RACK.STATUS</span> Operational</p>
        <h2 id="infrastructure-heading">Bare metal.<br /><em>Clean signal.</em></h2>
        <p class="scene-description">
          Enterprise server and storage administration designed around serviceability, observable health, and resilient data paths—from Dell and Lenovo class hardware to Linux hosts and RAID-backed storage.
        </p>

        <dl class="spec-grid">
          <div><dt>Compute</dt><dd>Rack servers · Linux</dd></div>
          <div><dt>Storage</dt><dd>RAID · Health monitoring</dd></div>
          <div><dt>Uplinks</dt><dd>10G SFP+ fabric</dd></div>
          <div><dt>Method</dt><dd>Documented operations</dd></div>
        </dl>

        <div class="signal-row" aria-label="Infrastructure topics">
          <span>iDRAC / XClarity</span><span>RAID</span><span>Virtualization</span><span>Linux</span>
        </div>
      </article>
    </div>
  </section>

  <section id="networking" class="scene-section" data-scene-index="2" aria-labelledby="networking-heading">
    <div class="scene-container scene-right">
      <article class="scene-copy glass-panel reveal">
        <div class="panel-index"><span>02</span><span>NETWORK FABRIC</span></div>
        <p class="scene-kicker"><span>ROUTE.TABLE</span> Converged</p>
        <h2 id="networking-heading">Traffic, segmented<br /><em>by design.</em></h2>
        <p class="scene-description">
          Managed switching, intentional VLAN boundaries, secure VPN routing, and fiber uplinks engineered as one understandable system—not a collection of disconnected boxes.
        </p>

        <div class="route-table" aria-label="Network architecture example">
          <div class="route-head"><span>SEGMENT</span><span>POLICY</span><span>STATE</span></div>
          <div><span>CORE / 10G</span><span>TRUNK</span><strong>ACTIVE</strong></div>
          <div><span>SERVERS / VLAN 20</span><span>ISOLATED</span><strong>ACTIVE</strong></div>
          <div><span>CCTV / VLAN 40</span><span>RESTRICTED</span><strong>ACTIVE</strong></div>
          <div><span>REMOTE / VPN</span><span>ENCRYPTED</span><strong>READY</strong></div>
        </div>

        <div class="signal-row">
          <span>Managed switching</span><span>VLAN</span><span>VPN</span><span>Firewall</span>
        </div>
      </article>
    </div>
  </section>

  <section id="development" class="scene-section" data-scene-index="3" aria-labelledby="development-heading">
    <div class="scene-container scene-left">
      <article class="scene-copy glass-panel reveal">
        <div class="panel-index"><span>03</span><span>DEVELOPMENT + AI</span></div>
        <p class="scene-kicker"><span>BUILD.PIPELINE</span> Passing</p>
        <h2 id="development-heading">Code with an<br /><em>infrastructure mindset.</em></h2>
        <p class="scene-description">
          Full-stack applications built with awareness of deployment, observability, security boundaries, and the Linux systems underneath them—plus practical local AI workflows where data control matters.
        </p>

        <div class="terminal-card" aria-label="Development stack terminal preview">
          <div class="terminal-bar"><i></i><i></i><i></i><span>sharif@ops:~/platform</span></div>
          <pre><code><span class="prompt">$</span> pnpm deploy:check
<span class="muted">→</span> next.js frontend       <b>ready</b>
<span class="muted">→</span> nestjs api            <b>healthy</b>
<span class="muted">→</span> postgres schema       <b>synced</b>
<span class="muted">→</span> local ai worker       <b>online</b></code></pre>
        </div>

        <div class="signal-row">
          <span>TypeScript</span><span>Next.js</span><span>NestJS</span><span>PostgreSQL</span><span>Local AI</span>
        </div>
      </article>
    </div>
  </section>

  <section id="monitoring" class="scene-section" data-scene-index="4" aria-labelledby="monitoring-heading">
    <div class="scene-container scene-right">
      <article class="scene-copy glass-panel reveal">
        <div class="panel-index"><span>04</span><span>CENTRAL OPERATIONS</span></div>
        <p class="scene-kicker"><span>VISION.CORE</span> Monitoring</p>
        <h2 id="monitoring-heading">One operational<br /><em>picture.</em></h2>
        <p class="scene-description">
          Centralized NVR and CCTV management connected to the same disciplined network model: isolated video traffic, clear retention planning, and a monitoring surface designed for rapid decisions.
        </p>

        <div class="monitor-grid" aria-label="Monitoring system states">
          <div><span>CAM / 01</span><strong>LIVE</strong><i></i></div>
          <div><span>CAM / 02</span><strong>LIVE</strong><i></i></div>
          <div><span>CAM / 03</span><strong>LIVE</strong><i></i></div>
          <div><span>NVR / A</span><strong>REC</strong><i></i></div>
        </div>

        <div class="signal-row">
          <span>NVR</span><span>CCTV</span><span>Central video</span><span>Retention</span>
        </div>
      </article>
    </div>
  </section>

  <section id="contact" class="scene-section contact-scene" data-scene-index="5" aria-labelledby="contact-heading">
    <div class="scene-container scene-center">
      <article class="contact-panel reveal">
        <p class="scene-kicker"><span>LINK.OPEN</span> Available for technical conversations</p>
        <h2 id="contact-heading">Build something<br /><span class="neon-type">resilient.</span></h2>
        <p>
          If you need someone who can move between the rack, the network, and the codebase, let’s start a focused conversation.
        </p>
        {linkedIn && (
          <a class="action action-primary contact-action" href={linkedIn.url} target="_blank" rel="noopener noreferrer">
            Connect on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        )}
        <div class="contact-meta">
          <span>Enterprise networking</span><span>Hardware operations</span><span>Full-stack systems</span>
        </div>
      </article>
    </div>
  </section>
</div>

<script>
  type SceneController = { destroy: () => void };

  const root = document.getElementById('experience-root');
  const host = document.getElementById('infrastructure-canvas');
  const fallback = document.getElementById('scene-fallback');
  const hudScene = document.getElementById('hud-scene');
  const railProgress = document.getElementById('rail-progress');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-scene-index]'));
  const links = Array.from(document.querySelectorAll<HTMLElement>('[data-scene-link]'));
  const labels = ['SYSTEM OVERVIEW', 'HARDWARE PLANE', 'NETWORK FABRIC', 'DEVELOPMENT + AI', 'CENTRAL OPERATIONS', 'SECURE CONTACT'];
  let controller: SceneController | null = null;

  function hasWebGL() {
    try {
      const canvas = document.createElement('canvas');
      return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'));
    } catch {
      return false;
    }
  }

  function shouldUseLiteMode() {
    return localStorage.getItem('sm-lite-mode') === 'true' ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  async function startScene() {
    controller?.destroy();
    controller = null;
    if (!root || !host || shouldUseLiteMode() || !hasWebGL()) {
      root?.classList.add('scene-is-lite');
      fallback?.classList.add('is-visible');
      return;
    }

    try {
      root.classList.remove('scene-is-lite');
      const { createInfrastructureScene } = await import('../three/InfrastructureScene');
      controller = createInfrastructureScene(host);
      root.classList.add('scene-is-ready');
      fallback?.classList.remove('is-visible');
    } catch (error) {
      console.error('Infrastructure scene failed to initialize', error);
      root.classList.add('scene-is-lite');
      fallback?.classList.add('is-visible');
    }
  }

  function updateInterface() {
    const center = window.scrollY + window.innerHeight * 0.5;
    let active = 0;
    sections.forEach((section, index) => {
      if (center >= section.offsetTop) active = index;
    });
    links.forEach((link, index) => link.classList.toggle('is-active', index === active));
    if (hudScene) hudScene.textContent = labels[active] ?? labels[0];
    if (railProgress) railProgress.style.height = `${(active / Math.max(1, sections.length - 1)) * 100}%`;
  }

  let interfaceFrame = 0;
  window.addEventListener('scroll', () => {
    cancelAnimationFrame(interfaceFrame);
    interfaceFrame = requestAnimationFrame(updateInterface);
  }, { passive: true });

  window.addEventListener('litemode', (event) => {
    const lite = (event as CustomEvent<{ lite: boolean }>).detail.lite;
    if (lite) {
      controller?.destroy();
      controller = null;
      root?.classList.add('scene-is-lite');
      fallback?.classList.add('is-visible');
    } else {
      startScene();
    }
  });

  updateInterface();
  startScene();
</script>

<style>
  .experience {
    position: relative;
    isolation: isolate;
  }

  .scene-layer {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background:
      radial-gradient(circle at 68% 42%, rgba(57, 255, 20, 0.055), transparent 31rem),
      linear-gradient(145deg, #0b0d0b 0%, #050605 52%, #0d100d 100%);
  }

  .scene-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 1s var(--ease-out), transform 1.4s var(--ease-out);
  }

  .scene-is-ready .scene-canvas {
    opacity: 1;
    transform: scale(1);
  }

  .scene-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .scene-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 6, 5, 0.82) 0%, rgba(5, 6, 5, 0.2) 40%, transparent 63%),
      radial-gradient(ellipse at center, transparent 36%, rgba(3, 4, 3, 0.66) 100%);
  }

  .scene-fallback {
    position: absolute;
    right: 12vw;
    top: 50%;
    width: min(34vw, 420px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .scene-fallback.is-visible { opacity: 0.75; }

  .fallback-rack {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44%;
    height: 70%;
    transform: translate(-50%, -50%) perspective(700px) rotateY(-12deg);
    padding: 8%;
    border: 1px solid rgba(57, 255, 20, 0.38);
    background: linear-gradient(145deg, rgba(57, 255, 20, 0.05), rgba(0, 0, 0, 0.5));
    box-shadow: inset 0 0 30px rgba(57, 255, 20, 0.06), 0 0 60px rgba(57, 255, 20, 0.08);
  }

  .fallback-rack span {
    display: block;
    height: 12%;
    margin-bottom: 7%;
    border: 1px solid rgba(57, 255, 20, 0.22);
    background: linear-gradient(90deg, #111511, #080a08);
    position: relative;
  }

  .fallback-rack span::after {
    content: '';
    position: absolute;
    right: 7%;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 9px var(--color-green);
  }

  .fallback-orbit {
    position: absolute;
    inset: 6%;
    border: 1px solid rgba(57, 255, 20, 0.16);
    border-radius: 50%;
    transform: rotateX(68deg) rotateZ(-12deg);
  }

  .scene-section {
    position: relative;
    min-height: 108svh;
    display: flex;
    align-items: center;
    scroll-margin-top: 5rem;
  }

  .scene-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(5, 6, 5, 0.12) 55%, transparent);
  }

  .scene-container {
    width: min(100% - 4rem, 88rem);
    margin-inline: auto;
    display: flex;
    position: relative;
    z-index: 2;
  }

  .scene-left { justify-content: flex-start; }
  .scene-right { justify-content: flex-end; }
  .scene-center { justify-content: center; text-align: center; }

  .scene-copy {
    width: min(48rem, 53vw);
  }

  .hero-scene { min-height: 100svh; }

  .hero-copy {
    width: min(56rem, 62vw);
    padding-top: 4rem;
  }

  .scene-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scene-kicker::before {
    content: '';
    width: 2.4rem;
    height: 1px;
    background: var(--color-green);
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.6);
  }

  .scene-kicker span { color: var(--color-green); }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3.6rem, 7.5vw, 8.8rem);
    line-height: 0.86;
    letter-spacing: -0.075em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .neon-type {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-green);
    text-shadow: 0 0 22px rgba(57, 255, 20, 0.2);
    position: relative;
  }

  .neon-type::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--color-green);
    opacity: 0.08;
    transform: translate(2px, 1px);
    clip-path: inset(55% 0 32%);
  }

  .hero-lede {
    max-width: 42rem;
    margin: 2rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.7;
    color: #b9c1ba;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .action {
    min-height: 3.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem 1.15rem;
    border: 1px solid transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.77rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .action-primary {
    min-width: 14.5rem;
    background: var(--color-green);
    color: #051005;
    box-shadow: 0 0 28px rgba(57, 255, 20, 0.15);
  }

  .action-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 38px rgba(57, 255, 20, 0.25);
  }

  .action-ghost {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(10, 13, 10, 0.5);
    backdrop-filter: blur(12px);
  }

  .action-ghost:hover { border-color: rgba(57, 255, 20, 0.6); }

  .hero-capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 48rem;
    margin-top: 4.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-capabilities > div {
    position: relative;
    padding: 1.15rem 1.25rem 0 0;
  }

  .hero-capabilities span {
    display: block;
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    margin-bottom: 0.45rem;
  }

  .hero-capabilities strong {
    display: block;
    font-size: 0.8rem;
    line-height: 1.35;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .hero-capabilities small {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .scroll-cue {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .scroll-cue i {
    display: block;
    width: 1px;
    height: 3rem;
    background: linear-gradient(var(--color-green), transparent);
  }

  .glass-panel {
    position: relative;
    padding: clamp(1.5rem, 3vw, 3rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(145deg, rgba(14, 17, 14, 0.86), rgba(7, 9, 7, 0.66));
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.32), inset 0 1px rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(22px) saturate(120%);
  }

  .glass-panel::before,
  .glass-panel::after {
    content: '';
    position: absolute;
    width: 2.8rem;
    height: 2.8rem;
    pointer-events: none;
  }

  .glass-panel::before {
    left: -1px;
    top: -1px;
    border-left: 1px solid var(--color-green);
    border-top: 1px solid var(--color-green);
  }

  .glass-panel::after {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid rgba(57, 255, 20, 0.45);
    border-bottom: 1px solid rgba(57, 255, 20, 0.45);
  }

  .panel-index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
  }

  .panel-index span:first-child {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(57, 255, 20, 0.5);
    color: var(--color-green);
  }

  h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5.4vw, 6.5rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-transform: uppercase;
  }

  h2 em {
    color: var(--color-green);
    font-style: normal;
    font-weight: 500;
  }

  .scene-description {
    max-width: 42rem;
    margin: 1.8rem 0 0;
    color: #aeb7af;
    font-size: 1rem;
    line-height: 1.78;
  }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 2rem 0 0;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .spec-grid div {
    min-width: 0;
    padding: 1rem;
    background: rgba(8, 10, 8, 0.78);
  }

  .spec-grid dt {
    margin-bottom: 0.35rem;
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .spec-grid dd {
    margin: 0;
    color: #d9ded9;
    font-size: 0.82rem;
  }

  .signal-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .signal-row span,
  .contact-meta span {
    padding: 0.48rem 0.65rem;
    border: 1px solid rgba(57, 255, 20, 0.2);
    background: rgba(57, 255, 20, 0.035);
    color: #aabdac;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .route-table {
    margin-top: 2rem;
    border-block: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .route-table > div {
    display: grid;
    grid-template-columns: 1.5fr 1fr 0.6fr;
    gap: 1rem;
    padding: 0.75rem 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.065);
