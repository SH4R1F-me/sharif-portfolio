---
import { profile } from "../../data/profile";
import { focusAreas } from "../../data/profile";
import { experience } from "../../data/experience";
import { projects } from "../../data/projects";
import { skills, skillCategories } from "../../data/skills";
import { socialLinks } from "../../data/socials";

const linkedIn = socialLinks.find((link) => link.platform === "linkedin");
const tryHackMe = socialLinks.find((link) => link.platform === "tryhackme");
const currentRole = experience[0];
const groupedSkills = skillCategories.map((category) => ({
  category,
  items: skills.filter((skill) => skill.category === category),
}));
const categorySummaries: Record<string, string> = {
  "Infrastructure & Hardware":
    "Deploying and supporting server, virtualization, and surveillance environments built for continuous operation.",
  "Enterprise Networking":
    "Designing secure, scalable connectivity across routed, switched, VLAN, firewall, and RF environments.",
  "Development & Automation":
    "Building self-hosted, database-driven systems and automation with an infrastructure-aware stack.",
  "Monitoring & Security":
    "Turning continuous monitoring, threat analysis, and authorized testing into actionable security decisions.",
};
const formatDate = (value?: string) =>
  value
    ? new Intl.DateTimeFormat("en", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
        .format(new Date(`${value}-01T00:00:00Z`))
        .toUpperCase()
    : "PRESENT";

const scenes = [
  { id: "hero", label: "Overview", code: "00" },
  { id: "about", label: "Profile", code: "01" },
  { id: "skills", label: "Matrix", code: "02" },
  { id: "experience", label: "Operations", code: "03" },
  { id: "projects", label: "Proof", code: "04" },
  { id: "contact", label: "Contact", code: "05" },
];
---

<div class="experience" id="experience-root">
  <div class="scene-layer" aria-hidden="true">
    <div id="infrastructure-canvas" class="scene-canvas"></div>
    <div id="scene-fallback" class="scene-fallback">
      <div class="fallback-rack">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="fallback-orbit"></div>
    </div>
    <div class="scene-vignette"></div>
  </div>

  <aside class="scene-rail" aria-label="Experience sections">
    <div class="rail-track" aria-hidden="true">
      <span id="rail-progress"></span>
    </div>
    <ol>
      {
        scenes.map((scene, index) => (
          <li>
            <a
              href={`#${scene.id}`}
              data-scene-link={index}
              aria-label={`Go to ${scene.label}`}
            >
              <span class="rail-code">{scene.code}</span>
              <span class="rail-label">{scene.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </aside>

  <div class="system-hud" aria-hidden="true">
    <span class="hud-pulse"></span>
    <span id="hud-scene">SYSTEM OVERVIEW</span>
    <span class="hud-separator">/</span>
    <span>LIVE</span>
  </div>

  <section
    id="hero"
    class="scene-section hero-scene"
    data-scene-index="0"
    aria-labelledby="hero-heading"
  >
    <div class="scene-container scene-left">
      <div class="scene-copy hero-copy reveal">
        <p class="scene-kicker">
          <span>SYS.00</span>
          {profile.professionalTitle}
        </p>
        <h1 id="hero-heading">
          {profile.heroLead}<br />
          <span class="neon-type" data-text={profile.heroAccent.toUpperCase()}
            >{profile.heroAccent}</span
          >
        </h1>
        <p class="hero-lede">
          {profile.shortSummary}
        </p>

        <div class="hero-actions">
          <a class="action action-primary" href="#about">
            Enter the network <span aria-hidden="true">↘</span>
          </a>
          {
            linkedIn && (
              <a
                class="action action-ghost"
                href={linkedIn.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>

        <div class="hero-capabilities" aria-label="Core capabilities">
          <div>
            <span>01</span><strong>Infrastructure</strong><small
              >Servers · VM · CCTV</small
            >
          </div>
          <div>
            <span>02</span><strong>Networking</strong><small
              >Cisco · VLAN · RF</small
            >
          </div>
          <div>
            <span>03</span><strong>Development</strong><small
              >Next.js · Python · Bash</small
            >
          </div>
          <div>
            <span>04</span><strong>Security</strong><small
              >VAPT · THM Top 6%</small
            >
          </div>
        </div>
      </div>

      <div class="scroll-cue" aria-hidden="true">
        <span>Scroll to enter</span>
        <i></i>
      </div>
    </div>
  </section>

  <section
    id="about"
    class="scene-section"
    data-scene-index="1"
    aria-labelledby="about-heading"
  >
    <div class="scene-container scene-left">
      <article class="scene-copy glass-panel reveal">
        <div class="panel-index">
          <span>01</span><span>OPERATOR PROFILE</span>
        </div>
        <p class="scene-kicker">
          <span>IDENTITY.VERIFIED</span> Operations-first
        </p>
        <h2 id="about-heading">
          Built in operations.<br /><em>Driven by security.</em>
        </h2>
        <p class="scene-description">
          {profile.longBio}
        </p>

        <dl class="spec-grid">
          <div><dt>Base</dt><dd>{profile.location}</dd></div>
          <div><dt>Field experience</dt><dd>Saudi Arabia · Bangladesh</dd></div>
          <div><dt>Operating mode</dt><dd>Monitor · Diagnose · Harden</dd></div>
          <div><dt>Status</dt><dd>{profile.availability}</dd></div>
        </dl>

        <div class="signal-row" aria-label="Professional focus areas">
          {focusAreas.map((area) => <span>{area}</span>)}
        </div>
      </article>
    </div>
  </section>

  <section
    id="skills"
    class="scene-section"
    data-scene-index="2"
    aria-labelledby="skills-heading"
  >
    <div class="scene-container scene-right">
      <article class="scene-copy glass-panel matrix-panel reveal">
        <div class="panel-index">
          <span>02</span><span>CAPABILITY MATRIX</span>
        </div>
        <p class="scene-kicker"><span>STACK.INDEX</span> Hands-on capability</p>
        <h2 id="skills-heading">
          From bare metal<br /><em>to attack surface.</em>
        </h2>
        <p class="scene-description">
          A field-tested stack spanning network operations, defensive analysis,
          system support, and practical automation.
        </p>

        <div class="skill-matrix" aria-label="Technical skill matrix">
          {
            groupedSkills.map((group, index) => (
              <section
                class="matrix-cell"
                aria-labelledby={`skill-group-${index}`}
              >
                <div class="matrix-cell-head">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3 id={`skill-group-${index}`}>{group.category}</h3>
                </div>
                <p>{categorySummaries[group.category]}</p>
                <ul role="list">
                  {group.items.map((skill) => (
                    <li>{skill.name}</li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </article>
    </div>
  </section>

  <section
    id="experience"
    class="scene-section"
    data-scene-index="3"
    aria-labelledby="experience-heading"
  >
    <div class="scene-container scene-left">
      <article class="scene-copy glass-panel reveal">
        <div class="panel-index">
          <span>03</span><span>LIVE OPERATIONS</span>
        </div>
        <p class="scene-kicker"><span>SHIFT.STATUS</span> Makkah · Active</p>
        <h2 id="experience-heading">
          Operate the system.<br /><em>Own the incident.</em>
        </h2>

        {
          currentRole && (
            <div class="role-console">
              <div class="role-console-head">
                <div>
                  <span>
                    {formatDate(currentRole.startDate)} —{" "}
                    {formatDate(currentRole.endDate)}
                  </span>
                  <h3>{currentRole.role}</h3>
                  <p>
                    {currentRole.organization} · {currentRole.location}
                  </p>
                </div>
                <strong>ON DUTY</strong>
              </div>
              <ul role="list">
                {currentRole.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="career-path" aria-label="Previous operational experience">
          {
            experience.slice(1).map((item) => (
              <div>
                <span>
                  {formatDate(item.startDate)} — {formatDate(item.endDate)}
                </span>
                <strong>{item.role}</strong>
                <small>
                  {item.organization} · {item.location}
                </small>
              </div>
            ))
          }
        </div>
      </article>
    </div>
  </section>

  <section
    id="projects"
    class="scene-section"
    data-scene-index="4"
    aria-labelledby="projects-heading"
  >
    <div class="scene-container scene-right">
      <article class="scene-copy glass-panel proof-panel reveal">
        <div class="panel-index"><span>04</span><span>PROOF OF WORK</span></div>
        <p class="scene-kicker">
          <span>EVIDENCE.LOG</span> Labs · Systems · Simulations
        </p>
        <h2 id="projects-heading">
          Practice measured.<br /><em>Systems modeled.</em>
        </h2>

        <div class="proof-grid">
          <article class="proof-card proof-card-featured">
            <div class="proof-card-head">
              <span>SECURITY LABS</span><strong>TOP 6%</strong>
            </div>
            <h3>TryHackMe</h3>
            <p>
              Consistent hands-on practice across offensive, defensive, Windows,
              Linux, web, OSINT, and forensics labs.
            </p>
            <dl class="metric-grid">
              <div><dt>42</dt><dd>Level</dd></div>
              <div><dt>75</dt><dd>Rooms</dd></div>
              <div><dt>11</dt><dd>Badges</dd></div>
            </dl>
            {
              tryHackMe && (
                <a
                  href={tryHackMe.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View verified profile <span aria-hidden="true">↗</span>
                </a>
              )
            }
          </article>

          {
            projects.map((project) => (
              <article class="proof-card">
                <div class="proof-card-head">
                  <>
                    <span>{project.category}</span>
                    <strong>PROJECT</strong>
                  </>
                </div>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul role="list">
                  <li>{project.approach[0]}</li>
                  <li>{project.outcomes[0]}</li>
                </ul>
                <div class="signal-row">
                  {project.tools.slice(0, 4).map((tool) => (
                    <span>{tool}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </article>
    </div>
  </section>

  <section
    id="contact"
    class="scene-section contact-scene"
    data-scene-index="5"
    aria-labelledby="contact-heading"
  >
    <div class="scene-container scene-center">
      <article class="contact-panel reveal">
        <p class="scene-kicker">
          <span>LINK.OPEN</span> Makkah · Ready to connect
        </p>
        <h2 id="contact-heading">
          Open a<br /><span class="neon-type" data-text="SECURE CHANNEL."
            >secure channel.</span
          >
        </h2>
        <p>
          Let’s talk network operations, resilient infrastructure, defensive
          security, or the next system worth hardening.
        </p>
        <div class="social-grid" aria-label="Professional profile links">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.label} profile — opens in new tab`}
              >
                <span>{link.label}</span>
                <small>{link.handle}</small>
                <strong aria-hidden="true">↗</strong>
              </a>
            ))
          }
        </div>
        <p class="availability-line">
          <i aria-hidden="true"></i>{profile.availability}
        </p>
      </article>
    </div>
  </section>
</div>

<script>
  type SceneController = { destroy: () => void };

  const root = document.getElementById("experience-root");
  const host = document.getElementById("infrastructure-canvas");
  const fallback = document.getElementById("scene-fallback");
  const hudScene = document.getElementById("hud-scene");
  const railProgress = document.getElementById("rail-progress");
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-index]"),
  );
  const links = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-link]"),
  );
  const labels = [
    "SYSTEM OVERVIEW",
    "OPERATOR PROFILE",
    "CAPABILITY MATRIX",
    "LIVE OPERATIONS",
    "PROOF OF WORK",
    "SECURE CONTACT",
  ];
  let controller: SceneController | null = null;

  function hasWebGL() {
    try {
      const canvas = document.createElement("canvas");
      return Boolean(canvas.getContext("webgl2") || canvas.getContext("webgl"));
    } catch {
      return false;
    }
  }

  function shouldUseLiteMode() {
    return (
      localStorage.getItem("sm-lite-mode") === "true" ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  }

  async function startScene() {
    controller?.destroy();
    controller = null;
    if (!root || !host || shouldUseLiteMode() || !hasWebGL()) {
      root?.classList.add("scene-is-lite");
      fallback?.classList.add("is-visible");
      return;
    }

    try {
      root.classList.remove("scene-is-lite");
      const { createInfrastructureScene } =
        await import("../three/InfrastructureScene");
      controller = createInfrastructureScene(host);
      root.classList.add("scene-is-ready");
      fallback?.classList.remove("is-visible");
    } catch (error) {
      console.error("Infrastructure scene failed to initialize", error);
      root.classList.add("scene-is-lite");
      fallback?.classList.add("is-visible");
    }
  }

  function updateInterface() {
    const center = window.scrollY + window.innerHeight * 0.5;
    let active = 0;
    sections.forEach((section, index) => {
      if (center >= section.offsetTop) active = index;
    });
    links.forEach((link, index) =>
      link.classList.toggle("is-active", index === active),
    );
    if (hudScene) hudScene.textContent = labels[active] ?? labels[0];
    if (railProgress)
      railProgress.style.height = `${(active / Math.max(1, sections.length - 1)) * 100}%`;
  }

  let interfaceFrame = 0;
  window.addEventListener(
    "scroll",
    () => {
      cancelAnimationFrame(interfaceFrame);
      interfaceFrame = requestAnimationFrame(updateInterface);
    },
    { passive: true },
  );

  window.addEventListener("litemode", (event) => {
    const lite = (event as CustomEvent<{ lite: boolean }>).detail.lite;
    if (lite) {
      controller?.destroy();
      controller = null;
      root?.classList.add("scene-is-lite");
      fallback?.classList.add("is-visible");
    } else {
      startScene();
    }
  });

  updateInterface();
  startScene();
</script>

<style>
  .experience {
    position: relative;
    isolation: isolate;
  }

  .scene-layer {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 68% 42%,
        rgba(57, 255, 20, 0.055),
        transparent 31rem
      ),
      linear-gradient(145deg, #0b0d0b 0%, #050605 52%, #0d100d 100%);
  }

  .scene-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.015);
    transition:
      opacity 1s var(--ease-out),
      transform 1.4s var(--ease-out);
  }

  .scene-is-ready .scene-canvas {
    opacity: 1;
    transform: scale(1);
  }

  .scene-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .scene-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 5, 0.82) 0%,
        rgba(5, 6, 5, 0.2) 40%,
        transparent 63%
      ),
      radial-gradient(
        ellipse at center,
        transparent 36%,
        rgba(3, 4, 3, 0.66) 100%
      );
  }

  .scene-fallback {
    position: absolute;
    right: 12vw;
    top: 50%;
    width: min(34vw, 420px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .scene-fallback.is-visible {
    opacity: 0.75;
  }

  .fallback-rack {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44%;
    height: 70%;
    transform: translate(-50%, -50%) perspective(700px) rotateY(-12deg);
    padding: 8%;
    border: 1px solid rgba(57, 255, 20, 0.38);
    background: linear-gradient(
      145deg,
      rgba(57, 255, 20, 0.05),
      rgba(0, 0, 0, 0.5)
    );
    box-shadow:
      inset 0 0 30px rgba(57, 255, 20, 0.06),
      0 0 60px rgba(57, 255, 20, 0.08);
  }

  .fallback-rack span {
    display: block;
    height: 12%;
    margin-bottom: 7%;
    border: 1px solid rgba(57, 255, 20, 0.22);
    background: linear-gradient(90deg, #111511, #080a08);
    position: relative;
  }

  .fallback-rack span::after {
    content: "";
    position: absolute;
    right: 7%;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 9px var(--color-green);
  }

  .fallback-orbit {
    position: absolute;
    inset: 6%;
    border: 1px solid rgba(57, 255, 20, 0.16);
    border-radius: 50%;
    transform: rotateX(68deg) rotateZ(-12deg);
  }

  .scene-section {
    position: relative;
    min-height: 108svh;
    display: flex;
    align-items: center;
    scroll-margin-top: 5rem;
  }

  .scene-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(5, 6, 5, 0.12) 55%,
      transparent
    );
  }

  .scene-container {
    width: min(100% - 4rem, 88rem);
    margin-inline: auto;
    display: flex;
    position: relative;
    z-index: 2;
  }

  .scene-left {
    justify-content: flex-start;
  }
  .scene-right {
    justify-content: flex-end;
  }
  .scene-center {
    justify-content: center;
    text-align: center;
  }

  .scene-copy {
    width: min(48rem, 53vw);
  }

  .hero-scene {
    min-height: 100svh;
  }

  .hero-copy {
    width: min(56rem, 62vw);
    padding-top: 4rem;
  }

  .scene-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scene-kicker::before {
    content: "";
    width: 2.4rem;
    height: 1px;
    background: var(--color-green);
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.6);
  }

  .scene-kicker span {
    color: var(--color-green);
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3.6rem, 7.5vw, 8.8rem);
    line-height: 0.86;
    letter-spacing: -0.075em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .neon-type {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-green);
    text-shadow: 0 0 22px rgba(57, 255, 20, 0.2);
    position: relative;
  }

  .neon-type::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--color-green);
    opacity: 0.08;
    transform: translate(2px, 1px);
    clip-path: inset(55% 0 32%);
  }

  .hero-lede {
    max-width: 42rem;
    margin: 2rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.7;
    color: #b9c1ba;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .action {
    min-height: 3.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem 1.15rem;
    border: 1px solid transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.77rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .action-primary {
    min-width: 14.5rem;
    background: var(--color-green);
    color: #051005;
    box-shadow: 0 0 28px rgba(57, 255, 20, 0.15);
  }

  .action-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 38px rgba(57, 255, 20, 0.25);
  }

  .action-ghost {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(10, 13, 10, 0.5);
    backdrop-filter: blur(12px);
  }

  .action-ghost:hover {
    border-color: rgba(57, 255, 20, 0.6);
  }

  .hero-capabilities {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 48rem;
    margin-top: 4.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-capabilities > div {
    position: relative;
    padding: 1.15rem 1.25rem 0 0;
  }

  .hero-capabilities span {
    display: block;
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    margin-bottom: 0.45rem;
  }

  .hero-capabilities strong {
    display: block;
    font-size: 0.8rem;
    line-height: 1.35;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .hero-capabilities small {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .scroll-cue {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .scroll-cue i {
    display: block;
    width: 1px;
    height: 3rem;
    background: linear-gradient(var(--color-green), transparent);
  }

  .glass-panel {
    position: relative;
    padding: clamp(1.5rem, 3vw, 3rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
